# Copy to .env and replace every placeholder. Never commit .env.

# PostgreSQL
POSTGRES_USER=libracore_app
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password
POSTGRES_DB=libracore

# Authentication (generate with: openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false

# First administrator, created only when the users table is empty.
# Password must be at least 12 characters.
BOOTSTRAP_ADMIN_NAME=Library Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional demo borrower, created on startup only if that member has no sign-in yet.
# The email must belong to an existing member (budi@example.com is in the sample data).
# Password must be at least 10 characters. Leave empty to skip.
BOOTSTRAP_BORROWER_EMAIL=budi@example.com
BOOTSTRAP_BORROWER_PASSWORD=replace-with-a-borrower-password

# Library policy
DAILY_FINE_IDR=2000
MAX_LOAN_ITEMS=5
LOAN_PERIOD_DAYS=14
DB_TIMEZONE=Asia/Jakarta
# Host port for pgAdmin/psql (bound to 127.0.0.1 only)
DB_HOST_PORT=5433
